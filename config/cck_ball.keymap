#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 1 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

// mt = mod-tap behavior | lt = layer-tap behavior

&mt {
    tapping-term-ms = <220>;    // Increased from default 200ms — hold window before modifier activates
    flavor = "balanced";        // If another key is pressed and released on mod-alt, Prefer mod
    quick-tap-ms = <180>;       // If pressed again within 180ms, treat as tap (prevents modifier on fast re-press)
};

/ {
    // Vertical scroll encoder behavior

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
    };

    // Horizontal scroll encoder behavior

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
    };

    // Switch applications (Alt+Tab / Alt+Shift+Tab)

    app_switch_encoder: app_switch_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp LA(TAB)>, <&kp LA(LS(TAB))>;
    };

    // Switch windows/tabs (Ctrl+Tab / Ctrl+Shift+Tab)

    win_switch_encoder: win_switch_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp LC(TAB)>, <&kp LC(LS(TAB))>;
    };

    hrm_l: hrm_l {
        compatible = "zmk,behavior-hold-tap";
        label = "HRM_L";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        flavor = "balanced";
        quick-tap-ms = <150>;
        require-prior-idle-ms = <175>;
        hold-trigger-on-release;
        hold-trigger-key-positions = <6 7 8 9 10 11 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 57 58 59>;
    };

    hrm_r: hrm_r {
        compatible = "zmk,behavior-hold-tap";
        label = "HRM_R";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        flavor = "balanced";
        quick-tap-ms = <150>;
        require-prior-idle-ms = <175>;
        hold-trigger-on-release;
        hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50>;
    };

    // Hold: activate En layer + LCTRL (ctrl_en macro). Tap: kp.
    // Left-hand key — triggers on right-hand key activity.
    hmc_l: hmc_l {
        compatible = "zmk,behavior-hold-tap";
        label = "HMC_L";
        bindings = <&ctrl_en>, <&kp>;

        #binding-cells = <1>;
        tapping-term-ms = <250>;
        flavor = "balanced";
        quick-tap-ms = <150>;
        require-prior-idle-ms = <175>;
        hold-trigger-on-release;
        hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 57 58 59>;
    };

    // Hold: activate En layer + LCTRL (ctrl_en macro). Tap: kp.
    // Right-hand key — triggers on left-hand key activity.
    hmc_r: hmc_r {
        compatible = "zmk,behavior-hold-tap";
        label = "HMC_R";
        bindings = <&ctrl_en>, <&kp>;

        #binding-cells = <1>;
        tapping-term-ms = <250>;
        flavor = "balanced";
        quick-tap-ms = <150>;
        require-prior-idle-ms = <175>;
        hold-trigger-on-release;
        hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50>;
    };

    behaviors {
    };

    macros {
        // Activate En layer (0) + hold LCTRL while key is held; release both on key up.
        // Zero-param so it can be used as the hold-behavior in a hold-tap node.
        ctrl_en: ctrl_en {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo 0 &kp LCTRL>
                , <&macro_pause_for_release>
                , <&macro_release &mo 0 &kp LCTRL>
                ;
            label = "CTRL_EN";
        };

        // Layer + modifier macro (analogous to QMK's LM()).
        // While this key is held: specified layer is active + modifier is pressed.
        // On release: both are released, previous layer stack is restored.
        // Usage: &lm <layer> <modifier>
        // Example: &lm 0 LCTRL — activate En layer with LCTRL held.
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_2to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
            label = "LM";
        };

        dash_long: dash_long {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_ALT &kp MINUS &kp MINUS &kp MINUS>;
            label = "DASH_LONG";
        };

        dash_short: dash_short {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_ALT &kp MINUS &kp MINUS &kp PERIOD>;
            label = "DASH_SHORT";
        };

        open_rquote_en: open_rquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RALT &kp LESS_THAN &kp LESS_THAN>;
            label = "OPEN_RQUOTE";
        };

        close_rquote_en: close_rquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RALT &kp GREATER_THAN &kp GREATER_THAN>;
            label = "CLOSE_RQUOTE";
        };

        layer_en: layer_un {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_UN";
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 2 &kp LS(LC(NUMBER_2))>;
            label = "LAYER_RU";
        };

        in_en: in_en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "IN_EN";
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(NUMBER_1))>;
            label = "TO_EN";
        };

        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(NUMBER_1))>;
            label = "TO_RU";
        };
    };

    combos {
        compatible = "zmk,combos";

        // K+H (En) / N+M (Ru) — positions 42+43 — activate Numbers layer
        combo_numbers {
            timeout-ms = <50>;
            key-positions = <42 43>;
            bindings = <&mo 5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        En {
            bindings = <
&kp ESC         &none    &none          &none           &none                &none       &none      &none           &none           &none          &none    &kp BACKSPACE
&kp TAB         &kp Q    &kp W          &kp F           &kp P                &kp B       &kp J      &kp L           &kp U           &kp Y          &none    &none
&none           &lt 1 A  &hrm_l LALT R  &hrm_l LCTRL S  &hrm_l LEFT_SHIFT T  &kp G       &kp M      &hrm_r LSHFT N  &hrm_r RCTRL E  &hrm_r LALT I  &lt 1 O  &none
&layer_en       &kp X    &kp C          &kp D           &kp V                &kp Z       &kp K      &kp H           &none           &none          &none    &layer_ru
&none           &none    &none          &lt 4 SPACE     &kp BACKSPACE        &kp DELETE  &mkp LCLK  &mkp RCLK       &lt 4 ENTER     &none          &none    &none
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;

            label = "Calemak-dh";
        };

        Sym-en {
            bindings = <
&trans     &trans           &trans         &trans            &trans             &trans         &trans       &trans                &trans                 &trans         &trans             &trans
&kp GRAVE  &kp TILDE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE       &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR     &kp SINGLE_QUOTE   &trans
&trans     &kp EXCLAMATION  &kp ASTERISK   &kp SLASH         &kp EQUAL          &kp AMPERSAND  &kp HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES  &trans
&layer_en  &kp QUESTION     &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT    &kp AT_SIGN  &kp COLON             &kp COMMA              &kp PERIOD     &kp SLASH          &layer_ru
&trans     &trans           &trans         &dash_long        &dash_short        &kp UNDERSCORE  &trans       &trans                &trans                 &trans         &open_rquote_en    &close_rquote_en
            >;
        };

        Ru {
            bindings = <
&kp ESC    &none    &none              &none           &none                &none       &none   &none            &none           &none              &none              &kp BACKSPACE
&kp TAB    &kp Q    &kp W              &kp E           &kp R                &kp T       &kp Y   &kp U            &kp I           &kp O              &kp P              &kp LBKT
&kp GRAVE  &lt 3 A  &hrm_l LEFT_ALT S  &hmc_l D  &hrm_l LEFT_SHIFT F  &kp G       &kp H   &hrm_r LSHIFT J  &hmc_r K  &hrm_r LEFT_ALT L  &lt 3 SEMICOLON    &kp APOS
&layer_en  &kp Z    &kp X              &kp C           &kp V                &kp B       &kp N   &kp M            &kp COMMA       &kp DOT            &kp RIGHT_BRACKET  &layer_ru
&none      &none    &none              &lt 4 SPACE     &kp BACKSPACE        &kp DELETE  &mkp LCLK  &mkp RCLK           &lt 4 ENTER     &none              &none              &none
            >;
        };

        Sym-ru {
            bindings = <
&trans        &trans           &trans            &trans               &trans                &trans            &trans          &trans                &trans                 &trans            &trans               &trans
&in_en GRAVE  &in_en TILDE2    &in_en LESS_THAN  &in_en GREATER_THAN  &kp MINUS             &in_en PIPE       &in_en CARET    &in_en LEFT_BRACE     &in_en RIGHT_BRACE     &in_en DOLLAR     &in_en SINGLE_QUOTE  &trans
&trans        &kp EXCLAMATION  &kp ASTERISK      &in_en SLASH         &kp EQUAL             &in_en AMPERSAND  &in_en HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &in_en SEMICOLON  &kp LS(NUMBER_2)     &trans
&layer_en     &kp LS(N7)       &kp PLUS          &in_en LEFT_BRACKET  &in_en RIGHT_BRACKET  &kp PERCENT       &in_en AT_SIGN  &kp LS(NUMBER_6)      &kp COMMA              &kp PERIOD        &in_en SLASH         &layer_ru
&trans        &trans           &trans            &dash_long           &dash_short           &kp UNDERSCORE  &trans          &trans                &trans                 &trans            &trans               &trans
            >;
        };

        F_layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&none   &kp F10       &kp F9        &kp F8        &kp F7        &trans        &kp PSCRN      &kp HOME      &kp UP     &kp END    &trans         &bt BT_CLR_ALL
&trans  &kp F11  &hrm_l LALT F3  &hrm_l LCTRL F2  &hrm_l LEFT_SHIFT F1  &trans  &kp LC(LEFT)   &kp LEFT      &kp DOWN   &kp RIGHT  &kp LC(RIGHT)  &trans
&trans  &kp F12  &kp F6  &kp F5  &kp F4  &none   &kp LC(PG_UP)  &kp PG_UP     &kp INS    &kp PG_DN  &kp LC(PG_DN)  &trans
&trans  &trans   &trans  &trans  &trans  &trans  &trans         &trans        &trans     &trans     &trans         &trans
            >;

            sensor-bindings = <&app_switch_encoder &win_switch_encoder>;
        };

        Numbers {
            bindings = <
&trans      &none         &none   &none   &none   &none         &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp SLASH     &kp N9  &kp N8  &kp N7  &kp ASTERISK  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp PLUS      &kp N3  &kp N2  &kp N1  &kp MINUS     &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp X         &kp N6  &kp N5  &kp N4  &kp PERCENT   &trans  &trans  &trans  &trans  &trans  &trans
&kp KP_DOT  &kp KP_COMMA  &kp N0  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
